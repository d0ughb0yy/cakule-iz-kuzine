---
import Icon from './Icon.astro';

interface Props {
  labels: {
    close: string;
    prev: string;
    next: string;
    of: string;
  };
}

const { labels } = Astro.props;
---

<dialog class="lightbox" id="lightbox" aria-labelledby="lightbox-caption">
  <div class="lightbox__inner">
    <button class="lightbox__btn lightbox__close" type="button" data-close aria-label={labels.close}>
      <Icon name="close" size={18} />
    </button>

    <figure class="lightbox__figure">
      <div class="lightbox__stage">
        <button class="lightbox__btn lightbox__nav lightbox__nav--prev" type="button" data-prev aria-label={labels.prev}>
          <Icon name="chevron-left" size={22} />
        </button>
        <button class="lightbox__btn lightbox__nav lightbox__nav--next" type="button" data-next aria-label={labels.next}>
          <Icon name="chevron-right" size={22} />
        </button>
        <img class="lightbox__img" src="" alt="" />
      </div>

      <figcaption class="lightbox__bar">
        <div class="lightbox__meta">
          <p class="lightbox__caption" id="lightbox-caption" aria-live="polite"></p>
          <p class="lightbox__count">
            <span data-current>1</span> {labels.of} <span data-total>1</span>
          </p>
        </div>
      </figcaption>
    </figure>
  </div>
</dialog>

<script is:inline>
  (() => {
    const dialog = document.getElementById('lightbox');
    if (!dialog) return;

    const triggers = Array.from(document.querySelectorAll('[data-lightbox]'));
    if (!triggers.length) return;

    const image = dialog.querySelector('.lightbox__img');
    const meta = dialog.querySelector('.lightbox__meta');
    const caption = dialog.querySelector('.lightbox__caption');
    const currentLabel = dialog.querySelector('[data-current]');
    const totalLabel = dialog.querySelector('[data-total]');
    const count = dialog.querySelector('.lightbox__count');
    const closeButton = dialog.querySelector('[data-close]');
    const prevButton = dialog.querySelector('[data-prev]');
    const nextButton = dialog.querySelector('[data-next]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const wait = (ms) => new Promise((resolve) => window.setTimeout(resolve, ms));

    // Triggers sharing a data-lightbox-group navigate together. A trigger with
    // no group opens on its own, with no arrows and no counter.
    const groups = new Map();
    triggers.forEach((trigger) => {
      const key = trigger.dataset.lightboxGroup;
      if (!key) return;
      if (!groups.has(key)) groups.set(key, []);
      groups.get(key).push(trigger);
    });

    const itemFrom = (trigger) => ({
      src: trigger.dataset.lightbox,
      alt: trigger.dataset.lightboxAlt || '',
      caption: trigger.dataset.lightboxCaption || '',
    });

    let items = [];
    let pending = 0;
    let token = 0;
    let closeTimer;
    let lastTrigger = null;

    const updateMeta = (item, index) => {
      caption.textContent = item.caption;
      currentLabel.textContent = String(index + 1);
      totalLabel.textContent = String(items.length);
    };

    const show = (index, direction = 0, immediate = false) => {
      const target = (index + items.length) % items.length;
      const item = itemFrom(items[target]);
      const myToken = ++token;
      pending = target;

      if (immediate || reduceMotion.matches) {
        image.classList.remove('is-out', 'is-in');
        image.style.setProperty('--shift', '0px');
        meta.classList.remove('is-changing');
        image.src = item.src;
        image.alt = item.alt;
        updateMeta(item, target);
        return;
      }

      image.classList.remove('is-in');

      const preload = new Image();
      preload.src = item.src;

      preload
        .decode()
        .catch(() => {})
        .then(async () => {
          if (myToken !== token) return;

          image.classList.add('is-out');
          meta.classList.add('is-changing');
          image.style.setProperty('--shift', `${direction * -10}px`);

          await wait(150);
          if (myToken !== token) return;

          image.src = item.src;
          image.alt = item.alt;
          updateMeta(item, target);

          image.style.setProperty('--shift', `${direction * 10}px`);
          image.classList.remove('is-out');
          image.classList.add('is-in');

          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              if (myToken !== token) return;
              image.style.setProperty('--shift', '0px');
              image.classList.remove('is-in');
              meta.classList.remove('is-changing');
            });
          });
        });
    };

    const open = (trigger) => {
      const group = trigger.dataset.lightboxGroup;
      items = group ? groups.get(group) : [trigger];
      const index = Math.max(0, items.indexOf(trigger));

      lastTrigger = trigger;
      window.clearTimeout(closeTimer);
      dialog.classList.remove('is-closing');

      const single = items.length < 2;
      dialog.classList.toggle('is-single', single);
      prevButton.hidden = single;
      nextButton.hidden = single;
      count.hidden = single;

      show(index, 0, true);
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';

      requestAnimationFrame(() => dialog.classList.add('is-open'));
      closeButton.focus({ preventScroll: true });
    };

    const close = () => {
      if (!dialog.open || dialog.classList.contains('is-closing')) return;

      token++;
      dialog.classList.remove('is-open');
      dialog.classList.add('is-closing');

      closeTimer = window.setTimeout(
        () => dialog.close(),
        reduceMotion.matches ? 0 : 240
      );
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => open(trigger));
    });

    closeButton.addEventListener('click', close);
    prevButton.addEventListener('click', () => {
      if (items.length > 1) show(pending - 1, -1);
    });
    nextButton.addEventListener('click', () => {
      if (items.length > 1) show(pending + 1, 1);
    });

    // Touch swipe navigation: swiping horizontally triggers the same
    // prev/next animation as the arrow buttons.
    const startTouch = { x: 0, y: 0, t: 0 };
    let suppressClick = false;
    let tracking = false;

    dialog.addEventListener('touchstart', (event) => {
      tracking = false;
      suppressClick = false;
      if (event.touches.length !== 1) return;
      if (event.target.closest('button')) return;

      startTouch.x = event.touches[0].clientX;
      startTouch.y = event.touches[0].clientY;
      startTouch.t = Date.now();
      tracking = true;
    });

    dialog.addEventListener('touchend', (event) => {
      if (!tracking) return;
      tracking = false;
      if (items.length < 2) return;
      if (event.changedTouches.length !== 1) return;

      const dx = event.changedTouches[0].clientX - startTouch.x;
      const dy = event.changedTouches[0].clientY - startTouch.y;
      const duration = Date.now() - startTouch.t;

      if (Math.abs(dx) < 8 || Math.abs(dx) <= Math.abs(dy)) return;

      const width = dialog.clientWidth || window.innerWidth;
      const flick = (Math.abs(dx) / (duration || 1)) * 1000 > 480;

      if (Math.abs(dx) > width * 0.25 || flick) {
        const direction = dx < 0 ? 1 : -1;
        suppressClick = true;
        show(pending + direction, direction);
      }
    });

    // A click anywhere but the photo itself (or a control) closes the dialog.
    dialog.addEventListener('click', (event) => {
      if (suppressClick) {
        suppressClick = false;
        return;
      }

      if (event.target === image || event.target.closest('button')) return;
      close();
    });

    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (items.length < 2) return;

      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(pending - 1, -1);
      }

      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(pending + 1, 1);
      }
    });

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      dialog.classList.remove('is-open', 'is-closing');
      token++;
      image.classList.remove('is-out', 'is-in');
      meta.classList.remove('is-changing');
      if (lastTrigger) lastTrigger.focus({ preventScroll: true });
    });
  })();
</script>
---
interface Props {
  name: 'arrow-right' | 'check' | 'close' | 'menu' | 'chevron-left' | 'chevron-right';
  size?: number;
}

const { name, size = 16 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-right' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'check' && <path d="M20 6 9 17l-5-5" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M18 6 6 18M6 6l12 12" />}
  {name === 'chevron-left' && <path d="m15 18-6-6 6-6" />}
  {name === 'chevron-right' && <path d="m9 18 6-6-6-6" />}
</svg>

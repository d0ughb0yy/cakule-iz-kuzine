---
import { site } from '../config';
import { getContent, type Lang } from '../lib/content';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
---

<section class="contact" id="kontakt" aria-labelledby="contact-title">
  <div class="wrap contact__grid">
    <div class="contact__text">
      <h2 id="contact-title" data-reveal>{t.contact.title}</h2>
      <p class="contact__lead" data-reveal style="--reveal-delay: 80ms">{t.contact.lead}</p>
      <p class="contact__note" data-reveal style="--reveal-delay: 140ms">{t.contact.note}</p>
    </div>

    <div class="contact__panel" data-reveal style="--reveal-delay: 100ms">
      <form
        class="contact-form"
        aria-label={t.contact.formLabel}
        data-contact-form
        data-email={site.contactEmail}
        data-subject={t.contact.subject}
        data-labels={JSON.stringify({
          name: t.contact.fields.name,
          surname: t.contact.fields.surname,
          email: t.contact.fields.email,
        })}
        novalidate
      >
        <div class="contact-form__row">
          <div class="contact-form__field">
            <label class="contact-form__label" for="contact-name">{t.contact.fields.name}</label>
            <input
              id="contact-name"
              class="contact-form__input"
              name="name"
              type="text"
              autocomplete="given-name"
              autocapitalize="sentences"
              aria-describedby="contact-name-hint"
              required
            />
            <p class="contact-form__hint" id="contact-name-hint">{t.contact.hints.name}</p>
          </div>

          <div class="contact-form__field">
            <label class="contact-form__label" for="contact-surname">
              {t.contact.fields.surname}
            </label>
            <input
              id="contact-surname"
              class="contact-form__input"
              name="surname"
              type="text"
              autocomplete="family-name"
              autocapitalize="sentences"
              aria-describedby="contact-surname-hint"
              required
            />
            <p class="contact-form__hint" id="contact-surname-hint">{t.contact.hints.surname}</p>
          </div>
        </div>

        <div class="contact-form__field">
          <label class="contact-form__label" for="contact-email">{t.contact.fields.email}</label>
          <input
            id="contact-email"
            class="contact-form__input"
            name="email"
            type="email"
            autocomplete="email"
            autocapitalize="off"
            aria-describedby="contact-email-hint"
            required
          />
          <p class="contact-form__hint" id="contact-email-hint">{t.contact.hints.email}</p>
        </div>

        <div class="contact-form__field">
          <label class="contact-form__label" for="contact-message">
            {t.contact.fields.message}
          </label>
          <textarea
            id="contact-message"
            class="contact-form__input contact-form__input--message"
            name="message"
            rows="5"
            maxlength="2000"
            autocapitalize="sentences"
            aria-describedby="contact-message-hint"
            required></textarea>
          <p class="contact-form__hint" id="contact-message-hint">{t.contact.hints.message}</p>
        </div>

        <button class="btn contact-form__submit" type="submit">
          {t.contact.fields.submit}
          <Icon name="arrow-right" />
        </button>

        <p class="contact-form__status" role="status" data-form-status hidden>
          {t.contact.status}
        </p>
      </form>

      <p class="contact-form__fallback">
        {t.contact.fallback.before}
        {' '}
        <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
        {' '}
        {t.contact.fallback.after}
        {' '}
        <a href={site.bookingUrl} target="_blank" rel="noopener noreferrer">
          {t.contact.fallback.booking}
        </a>
      </p>

      <p class="contact-form__privacy">{t.contact.privacy}</p>

      <noscript>
        <style>
          .contact-form__submit {
            display: none;
          }
        </style>
      </noscript>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const form = document.querySelector('[data-contact-form]');
    if (!form) return;

    const email = form.getAttribute('data-email') || '';
    const status = form.querySelector('[data-form-status]');

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      if (typeof form.reportValidity === 'function' && !form.reportValidity()) {
        return;
      }

      const data = new FormData(form);
      const value = (key) => String(data.get(key) || '').trim();
      const labels = JSON.parse(form.getAttribute('data-labels') || '{}');

      const body = [
        `${labels.name}: ${value('name')}`,
        `${labels.surname}: ${value('surname')}`,
        `${labels.email}: ${value('email')}`,
        '',
        value('message'),
      ].join('\n');

      const subject = form.getAttribute('data-subject') || '';
      const mailto =
        'mailto:' +
        email +
        '?subject=' +
        encodeURIComponent(subject) +
        '&body=' +
        encodeURIComponent(body);

      window.location.href = mailto;

      // The mailto hand-off changes nothing on the page itself, so say what
      // just happened — webmail users would otherwise see a silent no-op.
      if (status) status.hidden = false;
    });
  })();
</script>

---
import { routes, site } from '../config';
import { getContent } from '../lib/content';

interface Props {
  lang: 'hr' | 'en';
  current: 'home' | 'gallery';
}

const { lang, current } = Astro.props;
const t = getContent(lang);
const menuHref = `${routes.home[lang]}#jelovnici`;
---

<header class="site-header">
  <div class="wrap header__inner">
    <a class="brand" href={routes.home[lang]} aria-label={site.name} data-reveal>
      {site.name}
    </a>

    <nav
      class="header__nav"
      aria-label={t.nav.navigation}
      data-reveal
      style="--reveal-delay: 60ms"
    >
      <a class="header__link" href={menuHref}>{t.nav.menu}</a>
      <a
        class="header__link"
        href={routes.gallery[lang]}
        aria-current={current === 'gallery' ? 'page' : undefined}
      >
        {t.nav.gallery}
      </a>

      <div class="lang" aria-label={t.nav.language}>
        <a
          class="lang__item"
          href={routes[current]['hr']}
          hreflang="hr"
          lang="hr"
          aria-current={lang === 'hr' ? 'page' : undefined}
        >
          HR
        </a>
        <span class="lang__sep" aria-hidden="true">/</span>
        <a
          class="lang__item"
          href={routes[current]['en']}
          hreflang="en"
          lang="en"
          aria-current={lang === 'en' ? 'page' : undefined}
        >
          EN
        </a>
      </div>
    </nav>
  </div>
</header>

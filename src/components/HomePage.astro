---
import Icon from './Icon.astro';
import CtaBand from './CtaBand.astro';
import { routes, site } from '../config';
import { getContent, getGallery, getImage, type Lang } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);

const heroImage = getImage(t.hero.image);
const introImage = getImage(t.intro.image);
const howImage = getImage(t.how.image);
const allGallery = getGallery(lang);
const teaserItems = t.galleryTeaser.images
  .map((key) => allGallery.find((item) => item.imageKey === key))
  .filter((item): item is NonNullable<typeof item> => Boolean(item));
---

<section class="hero">
  <div class="wrap hero__grid">
    <div data-reveal>
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 set:html={t.hero.title} />
      <p class="hero__lead">{t.hero.lead}</p>

      <div class="hero__actions">
        <a
          class="btn"
          href={site.bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.hero.primaryCta}
          <Icon name="arrow-right" />
        </a>
        <a class="btn btn--ghost" href={routes.gallery[lang]}>{t.hero.secondaryCta}</a>
      </div>

      <ul class="trust">
        {t.hero.trust.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <figure class="hero__media" data-reveal>
      <img
        src={heroImage.src}
        width={heroImage.width}
        height={heroImage.height}
        alt={heroImage.alt[lang]}
        fetchpriority="high"
      />
      <figcaption class="hero__badge">{t.hero.badge}</figcaption>
    </figure>
  </div>
</section>

<section class="section" id="about">
  <div class="wrap intro__grid">
    <figure class="intro__media" data-reveal>
      <img
        src={introImage.src}
        width={introImage.width}
        height={introImage.height}
        alt={introImage.alt[lang]}
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="intro__body" data-reveal>
      <p class="eyebrow">{t.intro.eyebrow}</p>
      <h2>{t.intro.title}</h2>
      {t.intro.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

      <div class="intro__signature">
        <p class="signature">{t.intro.signature}</p>
        <a class="text-link" href="#how">
          {t.intro.link}
          <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </div>
</section>

<section class="how on-dark" id="how">
  <div class="wrap">
    <div class="how__head" data-reveal>
      <div>
        <p class="eyebrow">{t.how.eyebrow}</p>
        <h2>{t.how.title}</h2>
      </div>
      <p class="lead">{t.how.lead}</p>
    </div>

    <div class="how__body">
      <figure class="how__media" data-reveal>
        <img
          src={howImage.src}
          width={howImage.width}
          height={howImage.height}
          alt={howImage.alt[lang]}
          loading="lazy"
          decoding="async"
        />
      </figure>

      <ol class="steps">
        {
          t.how.steps.map((step, index) => (
            <li class="step" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
              <span class="step__num">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<section class="section included">
  <div class="wrap included__grid">
    <div data-reveal>
      <p class="eyebrow">{t.included.eyebrow}</p>
      <h2>{t.included.title}</h2>
      <p class="lead">{t.included.lead}</p>
    </div>

    <ul class="included__items" data-reveal>
      {
        t.included.items.map((item) => (
          <li class="included__item">
            <Icon name="check" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="section" id="menus">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">{t.menus.eyebrow}</p>
        <h2>{t.menus.title}</h2>
      </div>
      <p class="lead">{t.menus.lead}</p>
    </div>

    <div class="menu-grid">
      {
        t.menus.items.map((menu, index) => {
          const image = getImage(menu.image);
          return (
            <article class="menu-card" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
              <div class="menu-card__media">
                <img
                  src={image.src}
                  width={image.width}
                  height={image.height}
                  alt={image.alt[lang]}
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="menu-card__body">
                <h3>{menu.name}</h3>
                <p class="menu-card__desc">{menu.description}</p>

                <ul class="dish-list">
                  {menu.dishes.map((dish) => <li>{dish}</li>)}
                </ul>

                <p class="menu-card__price">{menu.price}</p>
                <a
                  class="text-link"
                  href={site.bookingUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {t.menus.cta}
                  <Icon name="arrow-right" />
                </a>
              </div>
            </article>
          );
        })
      }
    </div>

    <p class="menu-note">{t.menus.priceNote}</p>
  </div>
</section>

<section class="section teaser">
  <div class="wrap">
    <div class="teaser__head" data-reveal>
      <div>
        <p class="eyebrow">{t.galleryTeaser.eyebrow}</p>
        <h2>{t.galleryTeaser.title}</h2>
      </div>
      <a class="text-link" href={routes.gallery[lang]}>
        {t.galleryTeaser.cta}
        <Icon name="arrow-right" />
      </a>
    </div>

    <div class="teaser__grid" data-reveal>
      {
        teaserItems.map((item) => (
          <a
            class="teaser__item"
            href={routes.gallery[lang]}
            aria-label={item.caption}
          >
            <img
              src={item.src}
              width={item.width}
              height={item.height}
              alt={item.alt}
              loading="lazy"
              decoding="async"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">{t.testimonials.eyebrow}</p>
        <h2>{t.testimonials.title}</h2>
      </div>
    </div>

    <div class="quote-grid">
      {
        t.testimonials.items.map((quote, index) => (
          <figure class="quote" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
            <blockquote>
              <p>{quote.quote}</p>
            </blockquote>
            <figcaption>{quote.name}, {quote.location}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<section class="section" id="faq">
  <div class="wrap faq__grid">
    <div class="faq__aside" data-reveal>
      <p class="eyebrow">{t.faq.eyebrow}</p>
      <h2>{t.faq.title}</h2>
      <p class="lead">{t.faq.lead}</p>
    </div>

    <div class="faq-list" data-reveal>
      {
        t.faq.items.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<CtaBand
  eyebrow={t.cta.eyebrow}
  title={t.cta.title}
  lead={t.cta.lead}
  button={t.cta.button}
  note={t.cta.note}
/>

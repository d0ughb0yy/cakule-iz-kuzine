---
import Icon from './Icon.astro';
import CtaBand from './CtaBand.astro';
import { routes, site } from '../config';
import { getContent, getGallery, getImage, type Lang } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);

const heroImage = getImage(t.hero.image);
const introImage = getImage(t.intro.image);
const howImage = getImage(t.how.image);
const allGallery = getGallery(lang);
const teaserItems = t.galleryTeaser.images
  .map((key) => allGallery.find((item) => item.imageKey === key))
  .filter((item): item is NonNullable<typeof item> => Boolean(item));
const menuTotal = String(t.menus.items.length).padStart(2, '0');
---

<section class="hero">
  <div class="wrap hero__grid">
    <div data-reveal>
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 set:html={t.hero.title} />
      <p class="hero__lead">{t.hero.lead}</p>

      <div class="hero__actions">
        <a
          class="btn"
          href={site.bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.hero.primaryCta}
          <Icon name="arrow-right" />
        </a>
        <a class="btn btn--ghost" href={routes.gallery[lang]}>{t.hero.secondaryCta}</a>
      </div>

      <ul class="trust">
        {t.hero.trust.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <figure class="hero__media" data-reveal>
      <img
        src={heroImage.src}
        width={heroImage.width}
        height={heroImage.height}
        alt={heroImage.alt[lang]}
        fetchpriority="high"
      />
      <figcaption class="hero__badge">{t.hero.badge}</figcaption>
    </figure>
  </div>
</section>

<section class="section" id="about">
  <div class="wrap intro__grid">
    <figure class="intro__media" data-reveal>
      <img
        src={introImage.src}
        width={introImage.width}
        height={introImage.height}
        alt={introImage.alt[lang]}
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="intro__body" data-reveal>
      <p class="eyebrow">{t.intro.eyebrow}</p>
      <h2>{t.intro.title}</h2>
      {t.intro.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

      <div class="intro__signature">
        <p class="signature">{t.intro.signature}</p>
        <a class="text-link" href="#how">
          {t.intro.link}
          <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </div>
</section>

<section class="how on-dark" id="how">
  <div class="wrap">
    <div class="how__head" data-reveal>
      <div>
        <p class="eyebrow">{t.how.eyebrow}</p>
        <h2>{t.how.title}</h2>
      </div>
      <p class="lead">{t.how.lead}</p>
    </div>

    <div class="how__body">
      <figure class="how__media" data-reveal>
        <img
          src={howImage.src}
          width={howImage.width}
          height={howImage.height}
          alt={howImage.alt[lang]}
          loading="lazy"
          decoding="async"
        />
      </figure>

      <ol class="steps">
        {
          t.how.steps.map((step, index) => (
            <li class="step" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
              <span class="step__num">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<section class="section included">
  <div class="wrap included__grid">
    <div data-reveal>
      <p class="eyebrow">{t.included.eyebrow}</p>
      <h2>{t.included.title}</h2>
      <p class="lead">{t.included.lead}</p>
    </div>

    <ul class="included__items" data-reveal>
      {
        t.included.items.map((item) => (
          <li class="included__item">
            <Icon name="check" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="section" id="menus">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">{t.menus.eyebrow}</p>
        <h2>{t.menus.title}</h2>
      </div>
      <p class="lead">{t.menus.lead}</p>
    </div>

    <div class="menu-showcase" data-menu-showcase data-reveal>
      <div class="menu-tabs" role="tablist" aria-label={t.menus.tabsLabel}>
        {
          t.menus.items.map((menu, index) => (
            <button
              class="menu-tab"
              type="button"
              role="tab"
              id={`menu-tab-${index}`}
              aria-controls={`menu-panel-${index}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
            >
              {menu.name}
            </button>
          ))
        }
      </div>

      <div class="menu-stage">
        <div class="menu-slides">
          {
            t.menus.items.map((menu, index) => {
              const hasChoice = menu.courses.some((course) => course.options.length > 1);

              return (
                <article
                  class={`menu-sheet${index === 0 ? ' is-active' : ''}`}
                  role="tabpanel"
                  id={`menu-panel-${index}`}
                  aria-labelledby={`menu-tab-${index}`}
                  aria-hidden={index === 0 ? 'false' : 'true'}
                >
                  <header class="menu-sheet__head">
                    <h3>{menu.name}</h3>
                    <p class="menu-sheet__desc">{menu.description}</p>
                    <p class="menu-sheet__note">
                      {hasChoice ? t.menus.choiceNote : t.menus.tastingNote}
                    </p>
                  </header>

                  <div class="menu-courses">
                    {menu.courses.map((course) => (
                      <div class="menu-course">
                        <p class="menu-course__name">{course.name}</p>
                        <div class="menu-course__options" data-count={course.options.length}>
                          {course.options.map((option, optionIndex) => (
                            <>
                              {optionIndex > 0 && (
                                <span class="menu-course__or" aria-hidden="true">
                                  {t.menus.or}
                                </span>
                              )}
                              <p class="menu-course__option">{option}</p>
                            </>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>

                  <footer class="menu-sheet__foot">
                    <a
                      class="text-link"
                      href={site.bookingUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {t.menus.cta}
                      <Icon name="arrow-right" />
                    </a>
                  </footer>
                </article>
              );
            })
          }
        </div>
      </div>

      <div class="menu-controls">
        <button class="menu-arrow" type="button" data-menu-prev aria-label={t.menus.prev}>
          <Icon name="chevron-left" size={18} />
        </button>
        <div class="menu-dots" role="group" aria-label={t.menus.tabsLabel}>
          {
            t.menus.items.map((menu, index) => (
              <button
                class="menu-dot"
                type="button"
                data-menu-dot={index}
                aria-label={menu.name}
                aria-current={index === 0 ? 'true' : undefined}
              />
            ))
          }
        </div>
        <button class="menu-arrow" type="button" data-menu-next aria-label={t.menus.next}>
          <Icon name="chevron-right" size={18} />
        </button>
      </div>

      <p class="sr-only" aria-live="polite" data-menu-status>
        {t.menus.items[0].name} — 01 {t.menus.of} {menuTotal}
      </p>
    </div>
  </div>
</section>

<section class="section teaser">
  <div class="wrap">
    <div class="teaser__head" data-reveal>
      <div>
        <p class="eyebrow">{t.galleryTeaser.eyebrow}</p>
        <h2>{t.galleryTeaser.title}</h2>
      </div>
      <a class="text-link" href={routes.gallery[lang]}>
        {t.galleryTeaser.cta}
        <Icon name="arrow-right" />
      </a>
    </div>

    <div class="teaser__grid" data-reveal>
      {
        teaserItems.map((item) => (
          <a
            class="teaser__item"
            href={routes.gallery[lang]}
            aria-label={item.caption}
          >
            <img
              src={item.src}
              width={item.width}
              height={item.height}
              alt={item.alt}
              loading="lazy"
              decoding="async"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">{t.testimonials.eyebrow}</p>
        <h2>{t.testimonials.title}</h2>
      </div>
    </div>

    <div class="quote-grid">
      {
        t.testimonials.items.map((quote, index) => (
          <figure class="quote" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
            <blockquote>
              <p>{quote.quote}</p>
            </blockquote>
            <figcaption>{quote.name}, {quote.location}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<section class="section" id="faq">
  <div class="wrap faq__grid">
    <div class="faq__aside" data-reveal>
      <p class="eyebrow">{t.faq.eyebrow}</p>
      <h2>{t.faq.title}</h2>
      <p class="lead">{t.faq.lead}</p>
    </div>

    <div class="faq-list" data-reveal>
      {
        t.faq.items.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<CtaBand
  eyebrow={t.cta.eyebrow}
  title={t.cta.title}
  lead={t.cta.lead}
  button={t.cta.button}
  note={t.cta.note}
/>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-menu-showcase]');
    if (!root) return;

    const tabs = Array.from(root.querySelectorAll('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll('[role="tabpanel"]'));
    const dots = Array.from(root.querySelectorAll('[data-menu-dot]'));
    const stage = root.querySelector('.menu-stage');
    const status = root.querySelector('[data-menu-status]');
    const previous = root.querySelector('[data-menu-prev]');
    const next = root.querySelector('[data-menu-next]');

    if (!tabs.length || tabs.length !== panels.length) return;

    let index = 0;
    const pad = (value) => String(value).padStart(2, '0');

    const activate = (nextIndex, direction = 0) => {
      index = (nextIndex + panels.length) % panels.length;

      if (stage) {
        stage.style.setProperty('--menu-shift', direction ? `${direction * 18}px` : '0px');
      }

      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });

      panels.forEach((panel, panelIndex) => {
        const active = panelIndex === index;
        panel.classList.toggle('is-active', active);
        panel.setAttribute('aria-hidden', String(!active));
      });

      dots.forEach((dot, dotIndex) => {
        if (dotIndex === index) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });

      if (status) {
        status.textContent = `${tabs[index].textContent.trim()} — ${pad(index + 1)} / ${pad(panels.length)}`;
      }
    };

    tabs.forEach((tab, tabIndex) => {
      tab.addEventListener('click', () => activate(tabIndex));

      tab.addEventListener('keydown', (event) => {
        let target = null;
        let direction = 0;

        if (event.key === 'ArrowRight') {
          target = (tabIndex + 1) % tabs.length;
          direction = 1;
        } else if (event.key === 'ArrowLeft') {
          target = (tabIndex - 1 + tabs.length) % tabs.length;
          direction = -1;
        } else if (event.key === 'Home') {
          target = 0;
          direction = -1;
        } else if (event.key === 'End') {
          target = tabs.length - 1;
          direction = 1;
        }

        if (target === null) return;

        event.preventDefault();
        tabs[target].focus();
        activate(target, direction);
      });
    });

    dots.forEach((dot, dotIndex) => {
      dot.addEventListener('click', () => activate(dotIndex));
    });

    previous?.addEventListener('click', () => activate(index - 1, -1));
    next?.addEventListener('click', () => activate(index + 1, 1));

    let startX = 0;
    let startY = 0;
    let startTime = 0;

    stage?.addEventListener(
      'touchstart',
      (event) => {
        if (event.touches.length !== 1) return;
        startX = event.touches[0].clientX;
        startY = event.touches[0].clientY;
        startTime = Date.now();
      },
      { passive: true }
    );

    stage?.addEventListener(
      'touchend',
      (event) => {
        if (event.changedTouches.length !== 1) return;

        const dx = event.changedTouches[0].clientX - startX;
        const dy = event.changedTouches[0].clientY - startY;
        const duration = Date.now() - startTime;

        if (Math.abs(dx) < 40 || Math.abs(dx) <= Math.abs(dy)) return;

        const flick = (Math.abs(dx) / (duration || 1)) * 1000 > 420;
        if (Math.abs(dx) > 60 || flick) {
          const direction = dx < 0 ? 1 : -1;
          activate(index + direction, direction);
        }
      },
      { passive: true }
    );
  })();
</script>
